# ── BYD Account Credentials (required) ────────────────────────────────────
BYD_USERNAME=your_email_or_phone@example.com
BYD_PASSWORD=your_password

# ── BYD API (optional — defaults shown) ───────────────────────────────────
# BYD_BASE_URL=https://dilinkappoversea-eu.byd.auto
# BYD_COUNTRY_CODE=NL

# ── MacroDroid webhook base (optional — default points at this project's
#    own MacroDroid HTTP trigger). /api/control appends ?control=<action>.
# MACRODROID_BASE_URL=https://trigger.macrodroid.com/0de8afc4-6b8a-441f-b404-12214c310aaa/wh

# ── Control security (optional) ───────────────────────────────────────────
# If set, /api/control and /api/log require ?key=... or Authorization: Bearer.
# CONTROL_API_KEY=

# ── Control (optional) ────────────────────────────────────────────────────
# Dry-run mode: "1"/"true" simulates the phone instead of calling the real
# MacroDroid webhook. Useful for testing the polling pipeline.
# CONTROL_DRY_RUN=

# ── Shared log queue (optional but REQUIRED for production) ──────────────
# Without a shared store, the log queue lives in one serverless instance's
# memory: a poll routed to another instance gets 404 "No active control
# session" and the live log stops.
#   * EASIEST — Vercel's Redis integration sets REDIS_URL automatically
#     (a redis:// or rediss:// connection string, no token needed). Nothing
#     to enter here; the code picks it up at runtime.
#   REDIS_URL=rediss://user:pass@host:port
#   * Alternatives — any REST pair (requires BOTH vars of one pair):
#   * Vercel KV:     KV_REST_API_URL + KV_REST_API_TOKEN
#   * Upstash Redis: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#   * generic REST:  REDIS_URL (https://...) + REDIS_TOKEN
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
